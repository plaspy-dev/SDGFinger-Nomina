    CONTROL         "Lunes",IDC_CLUNES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,239,27,35,10
    CONTROL         "Martes",IDC_CMARTES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,239,36,38,10
