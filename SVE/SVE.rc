    CONTROL         "Jueves",IDC_CJUEVES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,239,54,39,10
    CONTROL         "Viernes",IDC_CVIERNES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,239,63,39,10
    CONTROL         "Sabado",IDC_CSABADO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,239,72,40,10
    CONTROL         "Domingos y festivos",IDC_CDOMINGO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,239,81,80,10
    CONTROL         "Cumplir horas semanales",IDC_RSEMANAL,"Button",BS_AUTORADIOBUTTON | WS_GROUP,11,80,95,10
    CONTROL         "",IDC_DSEMANAHORA,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,120,76,39,15
    CONTROL         "Almuerzo",IDC_CALMUERZO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,98,324,10
    CONTROL         "Salida",IDC_RALMUERZOHORARIO,"Button",BS_AUTORADIOBUTTON | WS_GROUP,20,115,35,10
    CONTROL         "",IDC_DALMUERZOSALIDA,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,63,111,56,15
    LTEXT           "Entrada",IDC_SALMUERZOENTRADA,130,114,26,8,NOT WS_GROUP
    CONTROL         "",IDC_DALMUERZOENTRADA,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,159,111,56,15
    CONTROL         "Horas de almuerzo",IDC_RALMUERZOTURNO,"Button",BS_AUTORADIOBUTTON,20,133,75,10
    CONTROL         "",IDC_DALMUERZOTURNO,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,120,131,39,15
    CONTROL         "Sabados",IDC_CSABADOS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,158,324,10
    CONTROL         "Entrada",IDC_RSABADOSHORARIO,"Button",BS_AUTORADIOBUTTON | WS_GROUP,20,174,41,10
    CONTROL         "",IDC_DSABADOSENTRADA,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,63,169,56,15
    LTEXT           "Salida",IDC_SSABADOSSALIDA,130,174,20,8,NOT WS_GROUP
    CONTROL         "",IDC_DSABADOSSALIDA,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,159,169,56,15
    CONTROL         "Horas del turno",IDC_RSABADOSTURNO,"Button",BS_AUTORADIOBUTTON,20,192,65,10
    CONTROL         "",IDC_DSABADOSTURNO,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,120,189,39,15
    CONTROL         "Festivos",IDC_CNOHABILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,215,324,10
    CONTROL         "Entrada",IDC_RNOHABILESHORARIO,"Button",BS_AUTORADIOBUTTON | WS_GROUP,20,232,41,10
    CONTROL         "",IDC_DNOHABILESENTRADA,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,63,229,56,15
    LTEXT           "Salida",IDC_SFESTIVOSSALIDA,130,232,20,8,NOT WS_GROUP
    CONTROL         "",IDC_DNOHABILESSALIDA,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,159,229,56,15
    CONTROL         "Horas del turno",IDC_RNOHABILESTURNO,"Button",BS_AUTORADIOBUTTON,20,251,65,10
    CONTROL         "",IDC_DNOHABILESTURNO,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,120,248,39,15
    LTEXT           "",IDC_SFIN,7,264,328,8
END

