IDD_DGUARDAR DIALOGEX 0, 0, 186, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Guardar"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Usuario",IDC_CUSUARIO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,40,10
    CONTROL         "Días",IDC_CDIAS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,21,29,10
    CONTROL         "Horas",IDC_CHORAS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,37,35,35,10
    DEFPUSHBUTTON   "Aceptar",IDOK,37,57,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,97,57,50,14
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,11,25,9,1
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,25,40,11,1
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDVERT,24,31,1,10
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDVERT,10,18,1,8
END

IDD_DHORARIO DIALOGEX 0, 0, 342, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Editar Horario"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Aceptar",IDOK,229,279,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,285,279,50,14
    CONTROL         "Horario diario",IDC_RDIARIO,"Button",BS_AUTORADIOBUTTON | WS_GROUP,11,10,59,10
