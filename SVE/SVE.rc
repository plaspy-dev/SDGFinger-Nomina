            VALUE "LegalCopyright", "SDG(c).  Reservados todos los derechos."
            VALUE "OriginalFilename", "SDGFingerN.exe"
            VALUE "ProductName", "SDGFingerN (Sistema de Nómina)"
            VALUE "ProductVersion", "1.2.5.1"
        END
    END
    BLOCK "VarFileInfo"
