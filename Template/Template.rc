//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,4,0
 PRODUCTVERSION 1,0,4,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04e4"
        BEGIN
            VALUE "CompanyName", "SDG (Software Developers Group)"
            VALUE "FileDescription", "SDG Nómina"
            VALUE "FileVersion", "1.0.4.0"
            VALUE "InternalName", "Template.exe"
            VALUE "LegalCopyright", "SDG (c). Reservados todos los derechos."
            VALUE "OriginalFilename", "SDGFingerN.exe"
            VALUE "ProductName", "Sistema ARQ"
            VALUE "ProductVersion", "1.0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0xc0a, 1252
    END
END


