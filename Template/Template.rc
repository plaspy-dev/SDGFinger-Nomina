/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\Template.ico"
IDR_TemplateTYPE        ICON                    "res\\TemplateDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"
IDR_TCORRESPONDENCIA    BITMAP                  "res\\toolbar1.bmp"
IDB_BUTTONS             BITMAP                  "res\\buttons.bmp"
IDB_FILELARGE           BITMAP                  "res\\filelarge.bmp"
IDB_FILESMALL           BITMAP                  "res\\filesmall.bmp"
IDB_MAIN                BITMAP                  "res\\main.bmp"
IDB_WRITELARGE          BITMAP                  "res\\writelarge.bmp"
IDB_WRITESMALL          BITMAP                  "res\\writesmall.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END

IDR_TCORRESPONDENCIA TOOLBAR  24, 24
BEGIN
    BUTTON      ID_BVER
    BUTTON      ID_BESPACIO
    BUTTON      ID_BESPACIO2
    BUTTON      ID_BCANCELAR
    BUTTON      ID_BBUSCAR
    BUTTON      ID_BUSUARIO
    BUTTON      ID_BCUSUARIOS
    BUTTON      ID_BSELECCIONAR
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "&Vista Preliminar",           ID_FILE_PRINT_PREVIEW
        MENUITEM "C&onfigurar Página",          ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 ID_CONFIGURACION_SERVIDORES
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de SDGFinger Nómina (TimeKeeper)...", ID_APP_ABOUT
    END
END

IDR_TemplateTYPE MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Guardar\tCtrl+S",            ID_FILE_SAVE
        MENUITEM "Guardar &como...",            ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "&Vista Preliminar",           ID_FILE_PRINT_PREVIEW
        MENUITEM "C&onfigurar Página",          ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Deshacer\tCtrl+Z",           ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cor&tar\tCtrl+X",             ID_EDIT_CUT
        MENUITEM "&Copiar\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "&Pegar\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 142
    END
    POPUP "&Ventana"
    BEGIN
        MENUITEM "&Cascada",                    ID_WINDOW_CASCADE
        MENUITEM "&Mosaico",                    ID_WINDOW_TILE_HORZ
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de SDGFinger Nómina (TimeKeeper)...", ID_APP_ABOUT
    END
END

IDR_WINDOWS_MENU MENU 
BEGIN
    MENUITEM "Nuevo",                       ID_WINDOW_NEW
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY 
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT
END


